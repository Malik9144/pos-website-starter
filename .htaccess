# POS Website Starter - .htaccess Configuration for cPanel

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# Disable Directory Listing
Options -Indexes

# Protect Sensitive Configuration Files
<FilesMatch "\.(env|ini|config|sql|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect Hidden System Files
<FilesMatch "^\.|^#.*#|~$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to public assets
<Directory public>
    Allow from all
</Directory>

# Security Headers
<IfModule mod_headers.c>
    # Prevent content type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Enable XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# PHP Configuration
<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>

# Compress Static Content (if mod_deflate available)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching (if mod_expires available)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # CSS & JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# Prevent Access to Backup Files
<FilesMatch "\.(sql|db|bak|backup|swp|swo)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent Script Injection
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} POST
    RewriteCond %{REQUEST_URI} ^.*\.(gif|jpg|jpeg|png|txt|html|htm|xml|zip)$ [NC]
    RewriteRule ^(.*)$ - [F]
</IfModule>
